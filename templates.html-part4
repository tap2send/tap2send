<style>
/* -----------------------------------------
   TAP2SEND PREMIUM UI — ANIMATIONS BOOSTER
------------------------------------------*/

/* Fade In */
.fade-in {
    animation: fadeIn .6s ease-out;
}
@keyframes fadeIn {
    0% { opacity: 0; transform: translateY(10px); }
    100% { opacity: 1; transform: translateY(0); }
}

/* Slide In Left */
.slide-left {
    animation: slideLeft .6s ease-out;
}
@keyframes slideLeft {
    0% { opacity:0; transform:translateX(-20px); }
    100% { opacity:1; transform:translateX(0); }
}

/* Slide In Right */
.slide-right {
    animation: slideRight .6s ease-out;
}
@keyframes slideRight {
    0% { opacity:0; transform:translateX(20px); }
    100% { opacity:1; transform:translateX(0); }
}

/* Smooth Scale */
.scale-in {
    animation: scaleIn .4s ease-out;
}
@keyframes scaleIn {
    0% { opacity:0; transform:scale(.93); }
    100% { opacity:1; transform:scale(1); }
}

/* Button Ripple */
.btn-main {
    position: relative;
    overflow: hidden;
}
.btn-main:after {
    content: "";
    position: absolute;
    background: rgba(255,255,255,.4);
    width: 0;
    height: 0;
    border-radius: 50%;
    left: 50%;
    top: 50%;
    opacity: 0;
    transform: translate(-50%, -50%);
}
.btn-main:active:after {
    width: 300px;
    height: 300px;
    opacity: 1;
    transition: width .4s ease-out, height .4s ease-out, opacity .6s ease-out;
}

/* Input Glow */
.input-box:focus {
    outline: none;
    border-color: var(--green);
    box-shadow: 0 0 12px rgba(12,122,67,.3);
}

/* Card Glow on Hover */
.card:hover {
    box-shadow: 0 0 20px rgba(0,0,0,0.15);
    transform: translateY(-4px) scale(1.01);
}

/* Section Dividers */
.section-divider {
    height: 2px;
    width: 100%;
    background: linear-gradient(to right, var(--blue), var(--gold));
    margin: 25px 0;
}

/* Template List Card Animation */
.template-item {
    animation: templateShow .4s ease-out;
}
@keyframes templateShow {
    0% { opacity:0; transform:translateY(6px); }
    100% { opacity:1; transform:translateY(0); }
}

/* Mobile fixes */
@media (max-width: 600px) {
    .card {
        padding: 15px;
        border-radius: 15px;
    }
    nav h1 {
        font-size: 22px;
    }
}
</style>
