<script>
/* ---------------------------
   UI POLISH & FINAL TOUCH
----------------------------*/

// Better template card style
function templateCardHTML(d, id) {
  return `
    <div class="template-item p-5 bg-white border border-gray-200 rounded-2xl shadow-sm">
        <div class="flex justify-between items-center mb-2">
            <h4 class="font-bold text-lg text-[var(--blue)]">${d.name}</h4>
            <span class="px-3 py-1 bg-[var(--green)] text-white rounded-full text-xs">${d.category}</span>
        </div>

        <p class="text-sm"><b>Header:</b> ${d.header || "-"}</p>
        <p class="text-sm mt-1"><b>Body:</b><br>${d.body}</p>
        <p class="text-sm mt-1"><b>Footer:</b> ${d.footer || "-"}</p>

        <button onclick="deleteTemplate('${id}')"
          class="mt-4 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition">
          Delete Template
        </button>
    </div>
  `;
}

// Override the loadTemplates to use new styling
async function loadTemplates() {
  let list = document.getElementById("templatesList");
  list.innerHTML = "<p class='text-gray-500'>Loading templates...</p>";

  const snap = await db
      .collection("users")
      .doc(currentUser.uid)
      .collection("templates")
      .orderBy("createdAt", "desc")
      .get();

  if (snap.empty) {
    list.innerHTML = `
      <div class="p-6 bg-white rounded-2xl text-center text-gray-500">
        No templates created yet.<br>
        Use the AI Generator or Create Template section above.
      </div>
    `;
    return;
  }

  list.innerHTML = "";

  snap.forEach(doc => {
    let d = doc.data();
    list.innerHTML += templateCardHTML(d, doc.id);
  });
}

/* Smooth toast messages for AI + Save */
function showToast(msg, type="success") {
  let color = type === "error" ? "red" : "green";
  let box = document.createElement("div");

  box.className = `fixed bottom-6 right-6 bg-${color}-600 text-white px-5 py-3 rounded-xl shadow-xl fade-in`;
  box.textContent = msg;

  document.body.appendChild(box);

  setTimeout(() => box.remove(), 3000);
}

// Replace old messages with toast use
const aiStatusElem = document.getElementById("aiStatus");
const saveStatusElem = document.getElementById("saveStatus");

const oldGenerateAI = generateAI;
generateAI = async function() {
  aiStatusElem.textContent = "";
  await oldGenerateAI();
  if (aiStatusElem.textContent.includes("Successfully")) {
    showToast("AI Template Generated!");
  }
}

const oldSaveTemplate = saveTemplate;
saveTemplate = async function() {
  saveStatusElem.textContent = "";
  await oldSaveTemplate();
  if (saveStatusElem.textContent.includes("Saved")) {
    showToast("Template Saved!");
  }
}

</script>

<!-- END OF TEMPLATE SYSTEM -->
</body>
</html>
