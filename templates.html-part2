<!-- FIREBASE SDK -->
<script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-firestore-compat.js"></script>

<script>
// ----------------------
// FIREBASE INIT
// ----------------------
const firebaseConfig = {
    apiKey: "AIzaSyDQMbfvjHV-1I3UEHt3asuEBNOO2Qh3RFA",
    authDomain: "tap2send-8e72d.firebaseapp.com",
    projectId: "tap2send-8e72d",
    storageBucket: "tap2send-8e72d.firebasestorage.app",
    messagingSenderId: "572191430506",
    appId: "1:572191430506:web:3100a351c4be63fbf6b713"
};

firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();

let currentUser = null;

// ----------------------
// AUTH CHECK
// ----------------------
auth.onAuthStateChanged(async (user) => {
  if(!user) {
    window.location.href = "login.html";
  } else {
    currentUser = user;
    loadTemplates();
  }
});

// ----------------------
// AI GENERATOR
// ----------------------
async function generateAI() {
  let prompt = document.getElementById("aiPrompt").value.trim();
  let type = document.getElementById("aiType").value.trim();
  let status = document.getElementById("aiStatus");

  if (!prompt) {
    status.textContent = "Enter something to generate!";
    status.style.color = "red";
    return;
  }

  status.textContent = "Generating… Please wait";
  status.style.color = "blue";

  try {
    // YOUR AI SERVER URL (Render)
    const response = await fetch("https://tap2send-ai.onrender.com/generate-template", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ prompt, type })
    });

    const data = await response.json();

    if (data.error) throw new Error(data.error);

    // AUTO-FILL TEMPLATE BUILDER
    document.getElementById("tempHeader").value = data.header || "";
    document.getElementById("tempBody").value = data.body || "";
    document.getElementById("tempFooter").value = data.footer || "";

    status.textContent = "Generated Successfully!";
    status.style.color = "green";

  } catch (err) {
    console.log(err);
    status.textContent = "AI Error: " + err.message;
    status.style.color = "red";
  }
}

// ----------------------
// SAVE TEMPLATE
// ----------------------
async function saveTemplate() {
  let name = document.getElementById("tempName").value.trim();
  let category = document.getElementById("tempCat").value.trim();
  let header = document.getElementById("tempHeader").value.trim();
  let body = document.getElementById("tempBody").value.trim();
  let footer = document.getElementById("tempFooter").value.trim();
  let status = document.getElementById("saveStatus");

  if (!name || !body) {
    status.textContent = "Name & Body required!";
    status.style.color = "red";
    return;
  }

  await db.collection("users")
          .doc(currentUser.uid)
          .collection("templates")
          .add({
            name, category, header, body, footer,
            createdAt: new Date()
          });

  status.textContent = "Template Saved!";
  status.style.color = "green";

  // Clear inputs
  document.getElementById("tempName").value = "";
  document.getElementById("tempHeader").value = "";
  document.getElementById("tempBody").value = "";
  document.getElementById("tempFooter").value = "";

  loadTemplates();
}

// ----------------------
// LOAD TEMPLATES
// ----------------------
async function loadTemplates() {
  let list = document.getElementById("templatesList");
  list.innerHTML = "<p class='text-gray-500'>Loading...</p>";

  const snap = await db.collection("users")
                       .doc(currentUser.uid)
                       .collection("templates")
                       .orderBy("createdAt", "desc")
                       .get();

  if (snap.empty) {
    list.innerHTML = "<p class='text-gray-500'>No templates yet.</p>";
    return;
  }

  list.innerHTML = "";

  snap.forEach(doc => {
    let d = doc.data();

    list.innerHTML += `
      <div class="p-4 bg-gray-50 border rounded-xl">
        <p><b>Name:</b> ${d.name}</p>
        <p><b>Category:</b> ${d.category}</p>
        <p><b>Header:</b> ${d.header || '-'}</p>
        <p><b>Body:</b> ${d.body}</p>
        <p><b>Footer:</b> ${d.footer || '-'}</p>

        <button onclick="deleteTemplate('${doc.id}')"
          class="mt-2 px-4 py-2 bg-red-500 text-white rounded-lg">
          Delete
        </button>
      </div>
    `;
  });
}
